# Copy to .env and fill in. NEVER commit .env.
SECRET_KEY_FLASK=replace-with-flask-secret
SESSION_LIFETIME_MINUTES=30
DEBUG=False

# ── Active Directory (management: writable, encrypted LDAPS) ──
AD_HOST=ad-example.example.com
AD_LDAPS_PORT=636
AD_DOMAIN=example.com
AD_BASE_DN=DC=example,DC=com
AD_BIND_USER=CN=AegisPass Service Account,OU=Service Accounts,DC=example,DC=com
AD_BIND_PASSWORD=change-me
AD_DC_HOST=ad-example.example.com
AD_CERT_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00

# ── Global Catalog (read-only, cross-domain lookups) ──
AD_GC_HOST=ad-example.example.com
AD_GC_PORT=3268

SLACK_BOT_TOKEN=
SLACK_ACTIVATION=False
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
RECAPTCHA_ENABLED=False

# ── Email (internal SMTP relay, no auth) ──
SMTP_ENABLED=False
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_SENDER=donoreply@example.com
SMTP_SENDER_NAME=AEGISPASS PASSWORD RESET
SMTP_USE_TLS=False
ADMIN_ALERT_EMAIL=Jhonattan.jimenez@example.com
# Password-expiry reminder thresholds (comma-separated days)
EXPIRY_REMINDER_DAYS=7,3

# ── SMS gateway (self-hosted Gammu REST; "none" disables) ──
# provider: none | mock | gammu | twilio
SMS_PROVIDER=none
SMS_GATEWAY_URL=
SMS_API_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

COMPANY=AegisPass
APP_NAME=AegisPass
