[Unit]
Description=AegisPass (Flask + gunicorn)
Documentation=file:///opt/aegispass/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/opt/aegispass

# Runtime environment
Environment=PYTHONPATH=/opt/aegispass
Environment=PYTHONUNBUFFERED=1
# For systemd-managed secrets, add:
# EnvironmentFile=/opt/aegispass/.env
# .env is gitignored and must never be committed.

# Idempotent bootstrap: create venv if gunicorn is missing
ExecStartPre=/bin/bash -c 'VENV=/opt/aegispass/.venv; if [ ! -x "$VENV/bin/gunicorn" ]; then python3.11 -m venv "$VENV"; "$VENV/bin/pip" install --upgrade pip; "$VENV/bin/pip" install -r /opt/aegispass/requirements.txt; fi'

# Bound to localhost; terminate TLS + proxy at nginx
ExecStart=/opt/aegispass/.venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 app:app

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/opt/aegispass
PrivateTmp=true

# [Install]
# Uncomment these lines (or run systemctl enable aegispass) to start on boot.
# WantedBy=multi-user.target
